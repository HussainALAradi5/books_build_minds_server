DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/books_builds_minds
JWT_SECRET_KEY=replace-with-a-long-random-secret
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser URL encoded in printed QR codes; set to your public domain or LAN address
PUBLIC_CLIENT_URL=http://localhost:3000

# Tap BHD sandbox only. Never commit actual keys.
TAP_SECRET_KEY=
# Public HTTPS endpoint ending in /api/payments/tap/webhook
TAP_WEBHOOK_URL=
# Shared Redis is mandatory when APP_ENV=production.
RATELIMIT_STORAGE_URI=memory://

# Password reset by email. For local testing, set PASSWORD_RESET_DELIVERY=console;
# the code is written to the Flask terminal. This mode is rejected in production.
PASSWORD_RESET_DELIVERY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
